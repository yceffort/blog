{
  "name": "yceffort-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "yceffort blog and research monorepo",
  "repository": {
    "url": "https://github.com/yceffort/yceffort-blog-v2",
    "type": "git"
  },
  "license": "MIT",
  "author": "yceffort <root@yceffort.kr>",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:blog": "pnpm --filter blog dev",
    "dev:research": "pnpm --filter research dev",
    "build": "pnpm -r build",
    "build:blog": "pnpm --filter blog build",
    "build:research": "pnpm --filter research build",
    "lint": "oxlint --type-aware && node apps/blog/scripts/check-markdown.mjs --quiet",
    "lint:fix": "oxlint --type-aware --fix",
    "prettier": "oxfmt --check .",
    "prettier:fix": "oxfmt ."
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2",
    "web-push": "^3.6.7"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "24.14.1",
    "pnpm": "11.20.0"
  }
}
