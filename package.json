{
  "name": "yceffort-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "yceffort blog and research monorepo",
  "repository": {
    "url": "https://github.com/yceffort/yceffort-blog-v2",
    "type": "git"
  },
  "license": "MIT",
  "author": "yceffort <root@yceffort.kr>",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:blog": "pnpm --filter blog dev",
    "dev:research": "pnpm --filter research dev",
    "build": "pnpm -r build",
    "build:blog": "pnpm --filter blog build",
    "build:research": "pnpm --filter research build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prettier": "oxfmt --check .",
    "prettier:fix": "oxfmt ."
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": "24.14.1",
    "pnpm": "10.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ],
    "overrides": {
      "form-data": ">=3.0.4",
      "micromatch": ">=4.0.8",
      "front-matter>js-yaml": "^3.14.2",
      "js-yaml@^4": ">=4.1.1",
      "@eslint/plugin-kit": ">=0.3.4",
      "mdast-util-to-hast": ">=13.2.1",
      "markdown-it-mermaid>mermaid": "^11.12.2",
      "@marp-team/marpit>js-yaml": "^4.1.1",
      "brace-expansion@>=1.0.0 <1.1.12": "^1.1.12",
      "brace-expansion@>=2.0.0 <2.0.2": "^2.0.2",
      "brace-expansion@>=4.0.0 <5.0.5": "^5.0.5",
      "lodash.trim": "npm:lodash@^4.17.21",
      "ajv@>=8.0.0 <8.18.0": "^8.18.0",
      "minimatch@<3.0.5": "^3.1.2",
      "minimatch@>=9.0.0 <10.2.3": "^10.2.3",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "qs": "^6.14.2",
      "markdown-it": "^14.1.1",
      "@isaacs/brace-expansion": "^5.0.1",
      "lodash": "^4.17.23",
      "lodash-es": "^4.18.1",
      "svgo": "^4.0.1",
      "protobufjs": "^7.5.5",
      "path-to-regexp": "^0.1.13",
      "picomatch": "^4.0.4",
      "flatted": "^3.4.2",
      "immutable": "^5.1.5",
      "dompurify": "^3.4.0",
      "sharp": "^0.35.0",
      "postcss@<8.5.18": ">=8.5.18",
      "yaml": "^2.8.3",
      "@tootallnate/once": "^3.0.1",
      "@xmldom/xmldom": "^0.9.9"
    }
  }
}
